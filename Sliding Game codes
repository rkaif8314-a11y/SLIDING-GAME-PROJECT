def find_blank():
    """Return row,col of blank (0)"""
    for r in range(4):
        for c in range(4):
            if board[r][c] == 0:
                return r, c

# ye function check kar raha hai ki game solve hua hai ya nhi
def is_solved():
    """Check if board is solved"""
    finish = list(range(1, 16)) + [0]
    flat = [board[r][c] for r in range(4) for c in range(4)]
    return flat == finish

def click_handler(mx, my): # this function will start when i click using mouse or on screen
    global moves, start_time #  Use of global to connect previous variable which i define
    if start_time is None:
        start_time = time.time()

    col = int((mx - start_x) // size)
    row = int((start_y - my) // size)

    if 0 <= row < 4 and 0 <= col < 4:
        blank_r, blank_c = find_blank()
        if abs(blank_r - row) + abs(blank_c - col) == 1:
            board[blank_r][blank_c], board[row][col] = board[row][col], board[blank_r][blank_c]
            moves += 1
            redraw_board()

            if is_solved():
                elapsed = int(time.time() - start_time)
                huors = elapsed //3600
                minutes = elapsed // 60
                seconds = elapsed % 60
                leaderboard.append((moves, minutes, seconds))
                leaderboard.sort(key=lambda x: (x[0], x[1]*60 + x[2]))
                redraw_board()

