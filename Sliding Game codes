def is_solvable(nums):
    """Ye check kar raha hai ki game soluable hai ya nhi"""
    flat = [n for n in nums if n != 0] # Sare numbers ko eak hi box me eak flat line me likh diya
    inversions = 0  # intially sare numbers ordered hai
    for i in range(len(flat)):
        for j in range(i+1, len(flat)):
            if flat[i] > flat[j]: # agar koi bada number chote ke pahle aata hai to inversion +1 ho jayega
                inversions += 1
    
    # code for blank box kaum se row me hai
    blank_index = nums.index(0) # assign kiya blank box ko 0
    blank_row = blank_index // 4 # for finding row number which contain 0
    blank_row_from_bottom = 4 - blank_row  #from bottom
    
    # solvable rule
    """ agar number of inversion even hai to vo soluable hai otherthan not at all"""
    if 4 % 2 == 0: # for puzzle size like that 4*4
        """Blank tile wala row agar even hai to number of inversion is odd & vice versa"""
        return (blank_row_from_bottom % 2 == 0) == (inversions % 2 == 1)
    else:
        return inversions % 2 == 0

def generate_board():
    nums = list(range(1, 16)) + [0] # for arranging numbers
    while True:
        random.shuffle(nums) # shuffling of numbers in the random order
        degree_of_shuffle = 1000 # for level of difficulty like that suffle level 1000
        if is_solvable(nums):
            break
        """for writing puzzle in 2D because easy to understand from row & column and also for understand the game that in 2D"""
    board = []
    for r in range(4):
        row = []
        for c in range(4):
            row.append(nums[r * 4 + c])
        board.append(row)
    return board

board = generate_board()# Again create into python graphics

# Grid ko banane ka code
def fill_box(x, y, size, num, color):
    """Grid ke sath number bhi eak sath likh jaye"""
    t.penup()
    t.goto(x, y)
    t.pendown()
    t.fillcolor(color)
    t.begin_fill()
    for _ in range(4):
        t.forward(size)
        t.right(90)
    t.end_fill()

    if num != 0:
        t.penup()
        t.goto(x + size / 2, y - size / 2) # for write in the center
        t.write(str(num), align="center", font=("Arial", 20, "bold")) #character of number & size
        t.pendown()

